flowchart TD
    subgraph Offline["1. Offline Ingestion"]
        direction TB
        RawPDFs["Raw PDFs"]
        Parser["LLM PDF Parsing<br/>(OpenRouter / Gemini)"]
        Chunks["Semantic Chunks"]

        subgraph Indexing["Indexing"]
            direction LR
            Embed["E5 Embeddings<br/>(intfloat/multilingual-e5-large)"]
            Metadata["File Metadata"]
        end

        Qdrant[("Qdrant<br/>(Vector Store / Knowledge Base)")]
        Mongo[("MongoDB<br/>(File Metadata)")]

        RawPDFs --> Parser
        Parser --> Chunks
        Chunks --> Embed
        RawPDFs --> Metadata
        Embed --> Qdrant
        Metadata --> Mongo
    end

    subgraph Runtime["2. Runtime Orchestration"]
        direction TB
        UserQuestion["User asks question"]
        ApiGateway["API Gateway"]
        Agent["AI Agent<br/>(LangGraph)"]
        Retriever["Retriever Service"]
        Dense["Dense Vector Search<br/>(Qdrant)"]
        Sparse["BM25 Search<br/>(in-memory index synced from Qdrant payloads)"]
        Hybrid["Hybrid Retrieval<br/>(Qdrant dense + BM25, fused by RRF)"]
        Rerank["BGE Reranker<br/>(BAAI/bge-reranker-v2-m3)"]
        Context["Top-n Refined Context"]
        Prompt["Context + Prompt"]
        Gemini["Gemini API<br/>(via OpenRouter)"]
        Final["Final Answer + Sources"]

        UserQuestion --> ApiGateway
        ApiGateway --> Agent
        Agent --> Retriever
        Retriever --> Dense
        Retriever --> Sparse
        Dense --> Hybrid
        Sparse --> Hybrid
        Hybrid --> Rerank
        Rerank --> Context
        Context --> Prompt
        Prompt --> Gemini
        Gemini --> Final
    end

    Qdrant -. "semantic vectors and chunk payloads" .-> Dense
    Qdrant -. "chunk payloads for BM25 sync" .-> Sparse
    Mongo -. "source metadata" .-> Retriever
